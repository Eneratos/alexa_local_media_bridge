# Container image
IMAGE_TAG=1.1.2

# Existing Docker network shared with the reverse proxy
PROXY_NETWORK=proxy

# Public HTTPS base URL without a trailing slash
PUBLIC_BASE_URL=https://media.example.com

# Independent random secrets used for signed URLs and Lambda requests
STREAM_SECRET=replace-with-a-long-random-secret
CONTROL_SECRET=replace-with-a-different-long-random-secret

# Navidrome
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME_B64=ZXhhbXBsZS11c2Vy
NAVIDROME_PASSWORD_B64=cmVwbGFjZS13aXRoLW5hdmlkcm9tZS1wYXNzd29yZA==

# Audiobookshelf
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_TOKEN_B64=cmVwbGFjZS13aXRoLWF1ZGlvYm9va3NoZWxmLXRva2Vu
AUDIOBOOKSHELF_LIBRARY_ID=example-library-id

# Signed stream URL lifetime in seconds
MUSIC_STREAM_TTL=14400
MAX_TOKEN_LIFETIME=14400

# Maximum permitted audiobook seek distance in seconds
MAX_ABS_SEEK_SECONDS=86400

# Navidrome resolver limits and caching
MAX_RANDOM_TRACKS=500
ALL_SONGS_CACHE_TTL=300
